# Server
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb://localhost:27017/grouplock

# Auth (used in later phases)
JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Google Maps (used in later phases - restrict this key by HTTP referrer in Google Cloud Console)
GOOGLE_MAPS_API_KEY=replace_with_your_key

# CORS
CLIENT_ORIGIN=http://localhost:5173

# PRIMUS AI brain (optional — enables general Q&A and live web search)
# Get a key at https://console.anthropic.com/
# Without this key, ride-specific commands (weather, group status, nearby places, etc.) still work.
# General/conversational questions will return a polite "brain is offline" message.
ANTHROPIC_API_KEY=

# PRIMUS model selection (defaults to claude-haiku-5-5 if not set)
PRIMUS_MODEL=claude-haiku-5-5

# Set to 'false' to disable web search tool in AI responses
PRIMUS_WEB_SEARCH=true
